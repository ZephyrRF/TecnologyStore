<!DOCTYPE html>
<html lang="es">
<head>
    <title>Editar Categoría · Inventario</title>
    <%- include('../layouts/head') %>
</head>
<body>
<%- include('../layouts/navbar') %>
<div class="page">
    <div class="page-header fade-up">
        <div>
            <h1>Editar Categoría</h1>
            <div class="subtitle"><%= categoria.nombre %></div>
        </div>
        <a href="/categorias" class="btn btn-ghost">← Volver</a>
    </div>

    <div class="card fade-up delay-1">
        <form id="editFormCat" class="form-grid">
            <div class="form-group">
                <label>Nombre *</label>
                <input type="text" id="nombre" class="form-control" value="<%= categoria.nombre %>" required>
            </div>
            <div class="form-group">
                <label>Descripción</label>
                <textarea id="descripcion" class="form-control"><%= categoria.descripcion || '' %></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                <a href="/categorias" class="btn btn-ghost">Cancelar</a>
            </div>
        </form>
    </div>
</div>
<script>
document.getElementById('editFormCat').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.submitter || e.target.querySelector('[type=submit]');
    btn.disabled = true;
    const id = "<%= categoria._id %>";
    const data = {
        nombre:      document.getElementById('nombre').value,
        descripcion: document.getElementById('descripcion').value
    };
    try {
        const res = await fetch(`/api/categorias/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (res.ok) {
            showToast('¡Categoría actualizada!', 'Los cambios fueron guardados.');
            setTimeout(() => window.location.href = '/categorias', 1600);
        } else {
            showToast('Error', 'No se pudo actualizar.', 'error');
            btn.disabled = false;
        }
    } catch { showToast('Error de red', '', 'error'); btn.disabled = false; }
});
</script>
</body>
</html>